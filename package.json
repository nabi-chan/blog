{
  "name": "eunsol-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "rm -rf public/content-assets public/og && vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "pnpm i18n:compile && content-collections build && tsc --noEmit",
    "test": "pnpm i18n:compile && vitest run --coverage",
    "smoke": "node scripts/smoke.ts",
    "indexnow": "node scripts/indexnow.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "content:rehash": "node scripts/content-rehash.ts",
    "content:check": "node scripts/content-check.ts",
    "audit:repo": "node scripts/audit.ts",
    "lint:fsd": "steiger ./src"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@inlang/paraglide-js": "2.29.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.4",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "0.62.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "steiger": "0.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  }
}
